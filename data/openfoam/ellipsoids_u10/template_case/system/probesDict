FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      probesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

probes
{
    type                probes;
    libs                ("libsampling.so");
    writeControl        timeStep;
    writeInterval       1;
    interpolationScheme cellPoint;
    fields              (U p);
    probeLocations
    #include "probePoints"
    ;
}


